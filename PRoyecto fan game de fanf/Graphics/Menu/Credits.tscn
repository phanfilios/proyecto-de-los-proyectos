[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Créditos del rediseño"
horizontal_alignment = 1

[node name="Body" type="RichTextLabel" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 320)
layout_mode = 2
bbcode_enabled = true
scroll_active = false
text = "[center][b]Proyecto base[/b]\nRepositorio Godot preexistente con estructura de menú, audio global y assets 2D.\n\n[b]Rediseño actual[/b]\nConversión del concepto original en un prototipo de fangame inspirado en Final Fantasy VI, con una nueva demo narrativa, menú reescrito, opciones simplificadas y combate por comandos.\n\n[b]Assets reutilizados[/b]\nSe reaprovecharon fondos e imágenes ya presentes en el repositorio para construir la ambientación del teatro magitek, el menú principal y las pantallas auxiliares.[/center]"

[node name="BackButton" type="Button" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
text = "Volver"

[connection signal="pressed" from="Center/Panel/Margin/VBox/BackButton" to="." method="_on_back_button_pressed"]
