[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Graphics/Menu/MainMenu.gd" id="1"]
[ext_resource type="Texture2D" path="res://Graphics/Menu/interfas v1..jpeg" id="2"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 6

[node name="Tint" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.02, 0.08, 0.55)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
custom_minimum_size = Vector2(780, 680)

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "FINAL FANTASY VI"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Ecos del Veldt · prototipo fangame construido sobre el proyecto original"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Description" type="RichTextLabel" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
bbcode_enabled = true
scroll_active = false
text = "[center]Reimaginé el proyecto como una demo inspirada en FF6.\n\nIncluye una misión narrativa corta, exploración guiada y un combate por comandos ambientado en un teatro magitek improvisado usando los assets existentes del repositorio.[/center]"

[node name="Buttons" type="VBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StartButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
layout_mode = 2
text = "Iniciar prototipo"

[node name="OptionsButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
layout_mode = 2
text = "Opciones"

[node name="CreditsButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
layout_mode = 2
text = "Créditos"

[node name="ExitButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
layout_mode = 2
text = "Salir"

[node name="Footer" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
modulate = Color(0.8, 0.8, 0.9, 1)
text = "Usa el menú para recorrer la demo y revisar el rediseño completo del proyecto."
horizontal_alignment = 1
autowrap_mode = 3

[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/OptionsButton" to="." method="_on_options_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/CreditsButton" to="." method="_on_credits_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/ExitButton" to="." method="_on_exit_button_pressed"]
